# ── Secrets (never commit) ────────────────────────────────────
.env
**/.env
*.key
*credentials*

# ── LaTeX build artifacts (regenerated from .tex) ─────────────
# cv.pdf is the raw xelatex output; the tracked deliverable is "<Name> - CV.pdf"
cv.pdf
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.bbl
*.blg
build.log
build_master.log

# ── Built example CV (ship the .tex source, not the PDF) ──────
master/*.pdf

# ── Generated dashboard (rebuilt from tracking/JOBS.md) ───────
ui/dashboard.html

# ── Crawler / pipeline generated files & scratch ──────────────
job_crawler/seen.json
job_crawler/suggestions.md
job_crawler/crawler.log
job_crawler/linkedin_emails/*.eml
job_crawler/candidates.json
job_crawler/linkedin_pipeline/email_cache.json
job_crawler/linkedin_pipeline/raw.json
job_crawler/linkedin_pipeline/candidates.json
job_crawler/linkedin_pipeline/candidates.md
job_crawler/linkedin_pipeline/recent.json
job_crawler/linkedin_pipeline/recent.md
job_crawler/linkedin_pipeline/recent_tagged.md
job_crawler/linkedin_pipeline/pipeline_seen.json

# ── OS / editor cruft ─────────────────────────────────────────
.DS_Store
__pycache__/
*.pyc
Screenshot*.png
