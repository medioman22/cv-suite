# Copy this file to job_crawler/.env and fill in your own keys.
# .env is git-ignored — never commit real credentials.

# Adzuna (free key for best Switzerland coverage): https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Gmail App Password for the LinkedIn email pipeline (NOT your normal password):
# Google Account → Security → 2-Step Verification → App passwords.
# You can also pass these inline instead of storing them here:
#   EMAIL_USER=you@gmail.com EMAIL_PASS='xxxx xxxx xxxx xxxx' bash linkedin_pipeline/run.sh
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_gmail_app_password

# Gemini API key for the daily-pipeline steps that use a cheap LLM: triage.py
# (score backlog rows) and refresh_status.py (check if a posting is still open).
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional: override the model used by triage.py (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
